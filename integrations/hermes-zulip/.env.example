# Copy to .env, fill in the bot's values, and keep the file out of version
# control. ZULIP_SITE may also be spelled ZULIP_BASE_URL.

# Required: the Zulip realm URL and the bot account's credentials.
ZULIP_SITE=https://chat.example.com
ZULIP_EMAIL=bot@example.com
ZULIP_API_KEY=...

# Optional: stream messages need an @-mention before reaching the agent.
# ZULIP_REQUIRE_MENTION=true

# Optional: comma-separated stream names; empty accepts every subscribed stream.
# ZULIP_ALLOWED_STREAMS=

# Optional: comma-separated Zulip user ids or emails allowed to use the bot.
# ZULIP_ALLOWED_USERS=

# Optional: allow every Zulip user; overrides ZULIP_ALLOWED_USERS.
# ZULIP_ALLOW_ALL_USERS=false

# Optional: cron/home target, e.g. stream:support/triage or @user@example.com.
# ZULIP_HOME_CHANNEL=

# Optional: split outbound messages longer than this many characters.
# ZULIP_MAX_MESSAGE_LENGTH=10000

# Optional: idle timeout for the Zulip event queue, in seconds.
# ZULIP_QUEUE_TIMEOUT_SECS=
